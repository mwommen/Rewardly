        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchant\": {\n    \"name\": \"Unknown Shop\"\n  },\n  \"purchase\": {\n    \"amount\": 42,\n    \"currency\": \"USD\"\n  },\n  \"wallet\": {\n    \"cards\": [{ \"cardId\": \"capital-one-venture\" }]\n  }\n}"
        },
        "url": "{{baseUrl}}/api/v1/payment-decisions"
      }
    },
    {
      "name": "OpenAPI",
      "request": {
