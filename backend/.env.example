NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://localhost:27017
FRONTEND_ORIGIN=http://localhost:5173
EXTENSION_ORIGIN=chrome-extension://replace-with-extension-id
REWARDLY_MERCHANT_INTELLIGENCE_MODE=registry
REWARDLY_ALLOW_DEV_OVERRIDES=true
REWARDLY_ACCESS_TOKEN_TTL_MS=900000
REWARDLY_REFRESH_TOKEN_TTL_MS=2592000000
REWARDLY_STRUCTURED_LOGS=false
REWARDLY_DISABLE_AUTH_RATE_LIMITS=false
REWARDLY_AUTH_RATE_LIMIT_SIGNUP_COUNT=5
REWARDLY_AUTH_RATE_LIMIT_SIGNUP_WINDOW_MS=900000
REWARDLY_AUTH_RATE_LIMIT_SIGNIN_COUNT=10
REWARDLY_AUTH_RATE_LIMIT_SIGNIN_WINDOW_MS=900000
REWARDLY_AUTH_RATE_LIMIT_REFRESH_COUNT=60
REWARDLY_AUTH_RATE_LIMIT_REFRESH_WINDOW_MS=900000
REWARDLY_AUTH_RATE_LIMIT_LOGOUT_COUNT=30
REWARDLY_AUTH_RATE_LIMIT_LOGOUT_WINDOW_MS=900000
REWARDLY_AUTH_RATE_LIMIT_DELETE_ACCOUNT_COUNT=3
REWARDLY_AUTH_RATE_LIMIT_DELETE_ACCOUNT_WINDOW_MS=3600000
REWARDLY_TRACE_DECISION=false
REWARDLY_DECISION_LOGS=false
REWARDLY_ENABLE_ANALYTICS_DASHBOARD=false
REWARDLY_ENABLE_FEEDBACK_DASHBOARD=false
REWARDLY_ANALYTICS_RETENTION_DAYS=30
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
