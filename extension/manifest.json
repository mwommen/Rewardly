{
  "manifest_version": 3,
  "name": "Rewardly",
  "version": "1.0",
  "description": "Shows the credit card benefit or best card to use when you reach checkout.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:5001/*",
    "http://localhost/*",
    "https://amazon.com/*",
    "https://*.amazon.com/*",
    "https://lululemon.com/*",
    "https://www.lululemon.com/*",
    "https://*.lululemon.com/*",
    "https://apple.com/*",
    "https://www.apple.com/*",
    "https://*.apple.com/*",
    "https://target.com/*",
    "https://www.target.com/*",
    "https://*.target.com/*",
    "https://bestbuy.com/*",
    "https://www.bestbuy.com/*",
    "https://*.bestbuy.com/*",
    "https://walmart.com/*",
    "https://www.walmart.com/*",
    "https://*.walmart.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://amazon.com/*",
        "https://*.amazon.com/*",
        "https://lululemon.com/*",
        "https://www.lululemon.com/*",
        "https://*.lululemon.com/*",
        "https://apple.com/*",
        "https://www.apple.com/*",
        "https://*.apple.com/*",
        "https://target.com/*",
        "https://www.target.com/*",
        "https://*.target.com/*",
        "https://bestbuy.com/*",
        "https://www.bestbuy.com/*",
        "https://*.bestbuy.com/*",
        "https://walmart.com/*",
        "https://www.walmart.com/*",
        "https://*.walmart.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rewardly"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/card-logos/*"],
      "matches": [
        "http://localhost/*",
        "https://amazon.com/*",
        "https://*.amazon.com/*",
        "https://lululemon.com/*",
        "https://www.lululemon.com/*",
        "https://*.lululemon.com/*",
        "https://apple.com/*",
        "https://www.apple.com/*",
        "https://*.apple.com/*",
        "https://target.com/*",
        "https://www.target.com/*",
        "https://*.target.com/*",
        "https://bestbuy.com/*",
        "https://www.bestbuy.com/*",
        "https://*.bestbuy.com/*",
        "https://walmart.com/*",
        "https://www.walmart.com/*",
        "https://*.walmart.com/*"
      ]
    }
  ]
}
